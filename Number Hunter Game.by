
import random

print("=" * 35)
print("       NUMBER HUNTER GAME")
print("=" * 35)

name = input("Enter your name: ")
score = 0

print(f"\nWelcome, {name}!")
print("Guess the secret number between 1 and 100.")
print("You have 7 attempts to win each round.")

while True:
    secret = random.randint(1, 100)
    attempts = 7

    while attempts > 0:
        try:
            guess = int(input("\nEnter your guess: "))

            if guess < 1 or guess > 100:
                print("Choose a number between 1 and 100!")
                continue

        except ValueError:
            print("Please enter a valid number!")
            continue

        if guess == secret:
            points = attempts * 10
            score += points
            print("\nCORRECT! YOU WON!")
            print(f"You earned {points} points!")
            break

        elif guess < secret:
            print("Too low! Try a higher number.")
        else:
            print("Too high! Try a lower number.")

        attempts -= 1
        print(f"Attempts left: {attempts}")

    else:
        print(f"\nGame over! The number was {secret}.")

    print(f"Your total score: {score}")

    again = input("\nPlay again? (yes/no): ").lower()

    if again != "yes":
        print(f"\nThanks for playing, {name}!")
        print(f"Final Score: {score}")
        print("GAME OVER!")
        break
